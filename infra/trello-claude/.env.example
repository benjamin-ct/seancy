# Copier ce fichier en .env (à côté de docker-compose-bobine.yml, jamais commité — voir
# .gitignore) et renseigner les vraies valeurs. docker-compose charge .env automatiquement.

# Token OAuth Claude Code (abonnement Pro/Max). Ne jamais définir ANTHROPIC_API_KEY à la
# place : sa seule présence bascule la facturation en mode API à l'usage.
CLAUDE_CODE_OAUTH_TOKEN=

# Clé + token API Trello (Power-Up admin > API Key, puis bouton "Token" pour le token membre).
TRELLO_API_KEY=
TRELLO_TOKEN=

# URL du webhook Discord utilisé pour les notifications de fin de pipeline.
DISCORD_WEBHOOK_URL=

# URL du webhook Discord dédié aux alertes Sentry (salon "erreurs-prod", id
# 1544711290273140877). À créer dans ce salon : Paramètres du salon > Intégrations > Webhooks >
# Nouveau Webhook, puis copier l'URL ici. Si laissé vide, les alertes Sentry retombent sur
# DISCORD_WEBHOOK_URL.
DISCORD_SENTRY_WEBHOOK_URL=

# Salon Discord ciblé par le prompt envoyé à Claude.
DISCORD_CHANNEL_ID=1543573331335315497

# Personal Access Token GitHub utilisé par `gh`/`git` dans le conteneur bobine-repo.
GH_TOKEN=

# Secret partagé attendu en query param (?secret=...) de l'URL configurée dans la règle
# d'alerte Sentry ("Send a notification via a webhook"). Rejette toute requête qui ne le
# fournit pas. Génère une valeur aléatoire longue (ex. `openssl rand -hex 32`).
SENTRY_WEBHOOK_SECRET=

# Token API Sentry (Settings > Auth Tokens, scope minimal `event:read`, ajouter
# `event:write`/`project:write` si Claude doit pouvoir résoudre/commenter les issues) utilisé
# par Claude, dans le conteneur bobine-repo, pour aller chercher le détail d'une issue déclenchée
# par le webhook Sentry (skill `sentry-triage`).
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

# DSN du projet Sentry de l'app (même projet, même valeur que le secret SENTRY_DSN déjà posé
# côté dashboard Cloudflare pour le Worker — Settings > Variables and Secrets). Utilisé par
# webhook-listener/sentry-log.js pour pousser les logs infra (pipeline Claude, webhooks), tagués
# source:infra — à distinguer des logs applicatifs (source:app, voir worker/sentry.ts et
# src/core/logger.ts) par un filtre Sentry plutôt qu'un projet séparé (ticket Trello "Avenir du
# développement"). Optionnel : no-op tant qu'absent.
SENTRY_DSN=

# Vérification visuelle par Claude (optionnel, voir README « Vérification visuelle »).
# Jeton de service Cloudflare Access (Zero Trust > Access > Service Auth > Service Tokens) :
# permet à bobine-screenshot d'ouvrir les previews de PR, protégées par Access.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Clé API TMDB (v3), pour que `wrangler dev` lancé en local dans le conteneur affiche de vraies
# données. Peut être la même que le secret TMDB_API_KEY du Worker.
TMDB_API_KEY=

# Modèle/effort de la session Claude (Trello, GitHub, CI, Discord). Défauts : claude-sonnet-5 / medium.
#CLAUDE_MODEL=claude-sonnet-5
#CLAUDE_EFFORT=medium
