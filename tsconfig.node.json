{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "scripts",
    "vite.config.ts",
    "src/core/api/movieMeta.ts",
    "src/core/api/releaseBadge.ts",
    "src/core/api/seriesEpisodeBadge.ts",
    "src/core/api/movieReleaseBadge.ts",
    "src/core/api/concurrencyLimiter.ts",
    "src/core/api/retryAfter.ts",
    "src/core/api/globalProviders.ts",
    "src/core/types/tmdb.ts",
    "src/core/types/library.ts",
    "src/core/lib/seriesRatings.ts",
    "src/core/validation/mediaType.ts",
    "src/shared/lib/numericRangeFilter.ts",
    "src/core/botDetection.ts",
    "worker/ai-suggestions-format.ts",
    "src/modules/changelog/changelogParser.ts",
    "src/modules/tickets/markdown.ts",
    "worker/bots.ts",
    "worker/rate-limit-memory.ts",
    "worker/tmdb-proxy-policy.ts",
    "worker/tmdb-edge-cache.ts",
    "worker/tmdb.ts",
    "worker/title-metadata.ts",
    "worker/security-headers.ts",
    "worker/validate.ts",
    "worker/tickets-logic.ts",
    "worker/release.ts",
    "worker/claude-usage.ts",
    "worker/quota-alerts.ts",
    "worker/admin-split.ts",
    "worker/hostnames.ts",
    "worker/ticket-title.ts",
    "worker/ticket-level.ts",
    "worker/access.ts",
    "worker/cloudflare-usage.ts",
    "worker/vapid.ts",
    "worker/notify-dedup.ts"
  ]
}
