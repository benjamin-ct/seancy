{
  "name": "seancy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "headers:generate": "node scripts/security-headers.ts",
    "verify:upcoming-badge": "node scripts/verify-upcoming-badge.ts",
    "verify:series-episode-badge": "node scripts/verify-series-episode-badge.ts",
    "verify:movie-release-badge": "node scripts/verify-movie-release-badge.ts",
    "verify:movie-meta": "node scripts/verify-movie-meta.ts",
    "verify:tmdb-concurrency-cap": "node scripts/verify-tmdb-concurrency-cap.ts",
    "verify:numeric-range-filter": "node scripts/verify-numeric-range-filter.ts",
    "verify:global-providers": "node scripts/verify-global-providers.ts",
    "verify:favorite-iso-codes": "node scripts/verify-favorite-iso-codes.ts",
    "verify:bot-detection": "node scripts/verify-bot-detection.ts",
    "verify:bot-detection-client": "node scripts/verify-bot-detection-client.ts",
    "verify:rate-limit-memory": "node scripts/verify-rate-limit-memory.ts",
    "verify:tmdb-proxy-policy": "node scripts/verify-tmdb-proxy-policy.ts",
    "verify:tmdb-retry-after": "node scripts/verify-tmdb-retry-after.ts",
    "verify:tmdb-edge-cache": "node scripts/verify-tmdb-edge-cache.ts",
    "verify:security-headers": "node scripts/security-headers.ts --check",
    "check:bundle-size": "node scripts/check-bundle-size.ts",
    "check:dead-code": "knip --include files,dependencies",
    "postinstall": "node scripts/generate-icons.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@sentry/cloudflare": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.3",
    "valibot": "^1.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "undici": "^7.29.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{css,json,jsonc,md}": [
      "prettier --write"
    ]
  }
}
