    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@sentry/cloudflare": "^10.73.0",
    "@sentry/react": "^10.73.0",
    "i18next": "^26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.3",
    "thumbhash": "^0.1.1",
    "valibot": "^1.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "undici": "^7.30.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{css,json,jsonc,md}": [
      "prettier --write"
    ]
  }
