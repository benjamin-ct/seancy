    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "headers:generate": "node scripts/security-headers.ts",
    "verify:upcoming-badge": "node scripts/verify-upcoming-badge.ts",
    "verify:series-episode-badge": "node scripts/verify-series-episode-badge.ts",
    "verify:movie-release-badge": "node scripts/verify-movie-release-badge.ts",
    "verify:movie-meta": "node scripts/verify-movie-meta.ts",
    "verify:tmdb-concurrency-cap": "node scripts/verify-tmdb-concurrency-cap.ts",
    "verify:numeric-range-filter": "node scripts/verify-numeric-range-filter.ts",
    "verify:global-providers": "node scripts/verify-global-providers.ts",
    "verify:favorite-iso-codes": "node scripts/verify-favorite-iso-codes.ts",
    "verify:bot-detection": "node scripts/verify-bot-detection.ts",
    "verify:bot-detection-client": "node scripts/verify-bot-detection-client.ts",
    "verify:rate-limit-memory": "node scripts/verify-rate-limit-memory.ts",
    "verify:tmdb-proxy-policy": "node scripts/verify-tmdb-proxy-policy.ts",
    "verify:tmdb-retry-after": "node scripts/verify-tmdb-retry-after.ts",
