    "verify:ai-suggestions": "node scripts/verify-ai-suggestions.ts",
    "verify:security-headers": "node scripts/security-headers.ts --check",
    "verify:changeset-parsing": "node scripts/verify-changeset-parsing.ts",
    "verify:changelog-release": "node scripts/verify-changelog-release.ts",
    "verify:changelog-parser": "node scripts/verify-changelog-parser.ts",
    "check:bundle-size": "node scripts/check-bundle-size.ts",
    "check:changeset": "node scripts/check-changeset.ts",
    "check:version-untouched": "node scripts/check-version-untouched.ts",
    "check:pii-fixtures": "node scripts/check-pii-fixtures.ts",
    "release:changelog": "node scripts/changelogRelease.ts",
    "preview:changelog": "node scripts/generateChangelogPreview.ts",
    "generate:thumbhashes": "node scripts/generate-thumbhashes.ts",
    "check:dead-code": "knip --include files,dependencies",
